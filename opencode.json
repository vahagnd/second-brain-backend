{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "read": {
            "*": "allow",
            ".env": "deny",
            ".opencode/traces/*": "deny",
            "scripts/*": "deny"
        }
    },
    "provider": {
        "openrouter": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "OpenRouter",
            "options": {
                "baseURL": "https://openrouter.ai/api/v1",
                "apiKey": "{env:OPENROUTER_API_KEY}"
            },
            "whitelist": [
                "minimax-m3",
                "deepseek-v4-flash",
                "glm-5.2"
            ],
            "models": {
                "deepseek-v4-flash": {
                    "name": "DeepSeek V4 Flash 0731",
                    "id": "deepseek/deepseek-v4-flash-0731",
                    "limit": {
                        "context": 393216,
                        "output": 65536
                    },
                    "options": {
                        "temperature": 1.0,
                        "topP": 0.95
                    }
                },
                "minimax-m3": {
                    "name": "MiniMax M3",
                    "id": "minimax/minimax-m3",
                    "limit": {
                        "context": 393216,
                        "output": 65536
                    },
                    "options": {
                        "temperature": 1.0,
                        "topP": 0.95,
                        "topK": 40
                    }
                },
                "glm-5.2": {
                    "name": "GLM 5.2",
                    "id": "z-ai/glm-5.2",
                    "limit": {
                        "context": 393216,
                        "output": 65536
                    },
                    "options": {
                        "temperature": 1.0,
                        "topP": 1.0
                    }
                }
            }
        }
    },

    "model": "openrouter/deepseek-v4-flash"
}
